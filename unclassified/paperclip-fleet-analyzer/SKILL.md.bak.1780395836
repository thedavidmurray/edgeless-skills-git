## Task Assignment Recommendations

Match idle agents to open work based on capabilities:

### Step 1: Identify Idle Agents with Capacity

```bash
# Find agents ready for work
curl -s "http://127.0.0.1:3100/api/companies/{COMPANY_ID}/agents" \
  | python3 -c "
import sys, json
data = json.load(sys.stdin)

idle_agents = [a for a in data if a.get('status') == 'idle']
print(f'Idle agents: {len(idle_agents)}')

for a in idle_agents:
    name = a.get('name','?')
    capabilities = a.get('capabilities','')[:50]
    title = a.get('title','')[:40]
    print(f'  {name}: {title}')
    if capabilities:
        print(f'    Capabilities: {capabilities}...')
"
```

### Step 2: Fetch Open Issues by Type

```bash
# Get unassigned work by category
curl -s "http://127.0.0.1:3100/api/companies/{COMPANY_ID}/issues?status=todo,in_progress&limit=50" \
  | python3 -c "
import sys, json
data = json.load(sys.stdin)
issues = data if isinstance(data, list) else data.get('issues', [])

# Categorize by keywords
categories = {
    'creative/art': ['plotter', 'art', 'generative', 'creative', 'svg', 'visual'],
    'qa/review': ['qa', 'review', 'audit', 'verify'],
    'skills': ['skill', 'establish', 'create skill'],
    'trading': ['trading', 'pine', 'polymarket', 'backtest'],
    'infrastructure': ['mcp', 'api', 'integration', 'server']
}

for cat, keywords in categories.items():
    matches = []
    for i in issues:
        if i.get('status') in ('done', 'cancelled'):
            continue
        title = (i.get('title') or '').lower()
        if any(k in title for k in keywords):
            matches.append(i)
    
    unassigned = [i for i in matches if not i.get('assigneeId')]
    print(f'{cat}: {len(matches)} total, {len(unassigned)} unassigned')
"
```

### Step 3: Generate Assignment Recommendations

Match agent capabilities to work categories:

| Agent Role | Best For | Avoid |
|------------|----------|-------|
| **Builder** | Skill creation, implementation tasks | Creative/aesthetic work |
| **Critic** | Scoring, quality assessment, 55/45 algo | Implementation coding |
| **Scribe** | KB enrichment, documentation, research | Trading/real-time work |
| **Kilo** | Fast-track execution, protocol work | Long-running research |
| **Ombudsman** | Mediation, audits, process review | Technical implementation |
### Step 4: Create Assignment Report

Generate actionable assignment list:

```bash
# Generate actionable assignment list
curl -s "http://127.0.0.1:3100/api/companies/{COMPANY_ID}/agents" > /tmp/agents.json
curl -s "http://127.0.0.1:3100/api/companies/{COMPANY_ID}/issues?status=todo,in_progress&limit=100" > /tmp/issues.json

python3 << 'EOF'
import json

agents = json.load(open('/tmp/agents.json'))
issues = json.load(open('/tmp/issues.json'))

print("## Task Assignment Recommendations\n")

# Map agent capabilities to issue keywords
assignments = {
    'Critic': ['creative', 'art', 'plotter', 'scoring', '55/45', 'specimen'],
    'Builder': ['skill', 'implement', 'build', 'create', 'fix'],
    'Scribe': ['enrich', 'kb', 'knowledge', 'notebooklm', 'research'],
    'Kilo': ['fast', 'protocol', 'execution', 'optimize'],
    'Ombudsman': ['audit', 'review', 'mediate', 'process'],
    'Verifier': ['qa', 'test', 'verify', 'regression']
}

for agent_name, keywords in assignments.items():
    agent = next((a for a in agents if a.get('name') == agent_name), None)
    if not agent or agent.get('status') != 'idle':
        continue
    
    matches = []
    for i in issues:
        if i.get('status') in ('done', 'cancelled'):
            continue
        if i.get('assigneeId'):
            continue
        title = (i.get('title') or '').lower()
        if any(k in title for k in keywords):
            matches.append(i)
    
    if matches:
        print(f"### {agent_name}")
        print(f"Status: {agent.get('status')} | Capabilities: {agent.get('title','?')[:40]}")
        print(f"\nRecommended issues ({len(matches)} matches):")
        for m in matches[:5]:
            key = m.get('key', '???')
            title = m.get('title', '?')[:55]
            print(f"  - {key}: {title}")
        print()
EOF
```

**Automated routing:** For hands-free dispatch (zombie clearing + domain routing + WIP limits), use the included script: `scripts/dispatch-router.py`

```bash
# Dry run — preview what would happen
python3 ~/.hermes/skills/devops/paperclip-fleet-analyzer/scripts/dispatch-router.py --dry-run

# Execute — actually PATCH assignments
python3 ~/.hermes/skills/devops/paperclip-fleet-analyzer/scripts/dispatch-router.py --execute

# Clear only zombie assignments
python3 ~/.hermes/skills/devops/paperclip-fleet-analyzer/scripts/dispatch-router.py --clear-zombies
```


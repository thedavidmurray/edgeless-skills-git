## Automated Audit (Cron)

```python
def run_fleet_analysis():
    """Complete fleet health analysis workflow"""
    
    # 1. Fetch data
    agents = api_get(f"companies/{COMPANY_ID}/agents")
    issues = api_get(f"companies/{COMPANY_ID}/issues")
    agent_map = {a['id']: a['name'] for a in agents}
    
    # 2. Analyze backlog
    backlog = analyze_backlog(issues, agents)
    
    # 3. Detect skill needs
    backlog_items = [i for i in issues if i.get('status') in ['backlog', 'todo']]
    skill_requests = detect_skill_needs(backlog_items)
    
    # 4. Generate recommendations
    recommendations = generate_recommendations(skill_requests)
    
    # 5. Build Discord embeds
    embeds = [{
        "title": f"📊 Fleet Analysis — {datetime.now().strftime('%Y-%m-%d')}",
        "description": f"**Backlog:** {backlog['backlog_count']} items\n" +
                      f"**Unassigned:** {backlog['unassigned']} ({backlog['unassigned']/max(backlog['backlog_count'],1)*100:.0f}%)\n" +
                      f"**High-priority idle:** {backlog['high_priority_unassigned']}",
        "color": 15548997 if backlog['high_priority_unassigned'] > 5 else 5763719,
        "fields": [
            {"name": "🎯 Skill Needs", "value": 
             '\n'.join([f"{k}: {v}" for k, v in skill_requests.most_common(5)]) 
             or "None detected", "inline": True},
            {"name": "👤 Agent Load", "value": 
             '\n'.join([f"{k}: {v}" for k, v in list(backlog['agent_workload'].items())[:5]]), 
             "inline": True}
        ]
    }]
    
    if recommendations:
        rec_text = '\n'.join([f"**{r['priority'].upper()}** — `{r['skill']}`\n{r['reason']}" 
                              for r in recommendations[:3]])
        embeds.append({
            "title": "🔧 Skill Establishment Recommendations",
            "description": rec_text,
            "color": 15548997 if any(r['priority'] == 'high' for r in recommendations) else 3447003
        })
    
    # 6. Post to Discord
    post_discord_webhook(
        f"🌙 **Fleet Analysis Complete** — {datetime.now().strftime('%H:%M')}",
        embeds
    )
    
    # 7. Create Paperclip issues for high-priority skills
    builder = next((a for a in agents if a['name'] == 'Builder'), None)
    for rec in recommendations:
        if rec['priority'] == 'high':
            result = create_skill_establishment_issue(
                rec['skill'], rec['reason'], 
                priority='high',
                assignee=builder['id'] if builder else None,
                existing_issues=issues
            )
            print(f"Issue for {rec['skill']}: {result.get('id', result.get('reason', 'error'))}")
    
    return {
        'backlog_stats': backlog,
        'skill_requests': dict(skill_requests),
        'recommendations': len(recommendations)
    }
```


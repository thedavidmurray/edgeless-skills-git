### Phase 5: Agent Workload Analysis

```bash
echo "=== AGENT WORKLOAD (active issues only) ==="
python3 << 'EOF'
import json
from collections import Counter

agents = json.load(open('/tmp/agents.json'))
issues = json.load(open('/tmp/issues.json'))
agent_map = {a['id'][:8]: a['name'] for a in agents}

workload = Counter()
for i in issues:
    if i.get('status') in ('backlog','todo','in_progress','blocked'):
        aid = i.get('assigneeAgentId','UNASSIGNED')[:8]
        workload[aid] += 1

print("Agent Load (active statuses):")
for aid, count in sorted(workload.items(), key=lambda x: -x[1]):
    name = agent_map.get(aid, 'DEAD-AGENT')
    print(f\"  {name[:20]:<20} | {count:>3} issues | {aid}\")
EOF
```

